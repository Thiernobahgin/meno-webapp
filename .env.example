# ── Frontend (safe to expose in the browser — Vite only inlines VITE_* vars) ──
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ── Server-side only (used by /api functions — NEVER prefix these with VITE_) ──
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_ANNUAL=price_...

ANTHROPIC_API_KEY=sk-ant-...

# Where Stripe should send people back after checkout (your deployed URL).
# Locally this is fine as-is; in production set it to your real domain in Vercel's
# environment variable settings.
PUBLIC_APP_URL=http://localhost:5173
